{
  "name": "playwright-resource-monitor",
  "version": "1.0.0",
  "description": "GitHub Action that monitors machine CPU and memory usage during Playwright test runs (via monocart-reporter) and fails the run when usage crosses the configured thresholds.",
  "license": "MIT",
  "private": true,
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ozkanpakdil/github-playwright-monitor"
  },
  "bugs": {
    "url": "https://github.com/ozkanpakdil/github-playwright-monitor/issues"
  },
  "homepage": "https://github.com/ozkanpakdil/github-playwright-monitor#readme",
  "scripts": {
    "build": "bun build src/index.ts --target=node --format=cjs --outfile dist/index.js",
    "test": "bun test",
    "all": "bun install && bun run build && bun test"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "bun": "^1.1.34",
    "typescript": "^5.7.2"
  }
}